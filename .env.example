# Never commit real credentials. Rotate any key that has been shared in chat.
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=

SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Recommended online profile. Use Qwen/Qwen3-Reranker-8B for the quality profile.
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
EMBEDDING_DIMENSION=4096

DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=1600

QDRANT_PATH=./data/index/qdrant
SQLITE_PATH=./data/metadata.db
RAW_DATA_DIR=./data/raw
MANIFEST_DIR=./data/manifests
COLLECTION_NAME=trade_compliance

DENSE_TOP_K=12
LEXICAL_TOP_K=12
RERANK_TOP_K=5
MIN_RERANK_SCORE=0.20
REQUEST_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO
DEBUG_CONTEXT=false
